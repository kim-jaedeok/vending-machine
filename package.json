{
  "name": "vending-machine-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.8.1"
  },
  "workspaces": [
    "packages/*",
    "packages/playground/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "preview": "turbo preview",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,html}\"",
    "check-types": "turbo check-types",
    "dev:react": "turbo dev --filter=@vending-machine/playground-react",
    "dev:react-threejs": "turbo dev --filter=@vending-machine/playground-react-threejs",
    "build:react": "turbo build --filter=@vending-machine/playground-react",
    "build:react-threejs": "turbo build --filter=@vending-machine/playground-react-threejs",
    "preview:react": "turbo preview --filter=@vending-machine/playground-react",
    "preview:react-threejs": "turbo preview --filter=@vending-machine/playground-react-threejs"
  },
  "dependencies": {
    "auto-bind": "^5.0.1",
    "classnames": "^2.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.25.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.4",
    "turbo": "^2.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.2",
    "vite-plugin-checker": "^0.9.1"
  },
  "packageManager": "pnpm@10.8.1+sha512.c50088ba998c67b8ca8c99df8a5e02fd2ae2e2b29aaf238feaa9e124248d3f48f9fb6db2424949ff901cffbb5e0f0cc1ad6aedb602cd29450751d11c35023677"
}
