{
  "name": "@vending-machine/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@vending-machine/core": "workspace:*",
    "@vending-machine/types": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "prettier": "^3.3.3",
    "typescript": "5.5.3"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
